NEXT_PUBLIC_GTM =
NEXT_PUBLIC_APP_URL =
TELEGRAM_BOT_TOKEN =
TELEGRAM_CHAT_ID =
GMAIL_PASSKEY =
EMAIL_ADDRESS =

# --- Portfolio RAG chatbot (app/api/chat) ---
# Supabase project used as the vector store + rate-limit counter
# (n8n-automation project, public.portfolio_vec / public.portfolio_rate_limits).
SUPABASE_URL =
SUPABASE_SERVICE_ROLE_KEY =

# Self-hosted OpenAI-compatible LLM gateway. API key is secret — set it in
# Vercel/your local .env only, never commit it.
OMNIROUTE_BASE_URL = https://omniroute.code2vibe.dev/v1
OMNIROUTE_API_KEY =
CHAT_MODEL = antigravity/gemini-3.7-flash-high
# Must be an embeddings-capable model available on the gateway above — confirm
# via GET {OMNIROUTE_BASE_URL}/models with your key before setting this.
EMBEDDING_MODEL =

