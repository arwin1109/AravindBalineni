NEXT_PUBLIC_GTM =
NEXT_PUBLIC_APP_URL =
TELEGRAM_BOT_TOKEN =
TELEGRAM_CHAT_ID =
GMAIL_PASSKEY =
EMAIL_ADDRESS =

# --- Portfolio RAG chatbot (app/api/chat) ---
# Supabase project used as the vector store + rate-limit counter
# (n8n-automation project, public.portfolio_vec / public.portfolio_rate_limits).
SUPABASE_URL =
SUPABASE_SERVICE_ROLE_KEY =

# Cohere, via its OpenAI-compatible endpoint (api.cohere.ai/compatibility/v1).
# API key is secret — set it in Vercel/your local .env only, never commit it.
COHERE_API_KEY =
CHAT_MODEL = command-a-plus-05-2026
EMBEDDING_MODEL = embed-v4.0

# Optional overrides (defaults shown)
# PORTFOLIO_CHAT_RATE_LIMIT = 5
# PORTFOLIO_CHAT_IP_RATE_LIMIT = 30
# Ceiling on total chat requests per UTC day, across every visitor combined —
# a cost/abuse circuit breaker independent of the per-visitor and per-IP caps.
# PORTFOLIO_CHAT_GLOBAL_DAILY_LIMIT = 200